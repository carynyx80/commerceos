# Commerce OS — environment reference. Copy the relevant block into apps/api/.env, apps/worker/.env
# and the Vercel project for apps/web. Never commit real values.

# --- shared (api + worker) ---
DATABASE_URL=postgresql://commerce:commerce@127.0.0.1:54330/commerce_os   # managed Postgres in production; session timezone must be UTC
CHAIN_ID=31337                         # 31337 local · 46630 Robinhood testnet · 4663 Robinhood mainnet
RPC_URL=http://127.0.0.1:8545          # use a dedicated provider endpoint in production
BNB_CHAIN_ID=31338                     # optional: enables BNB Chain (USDC + BNB). 31338 local · 97 BSC testnet · 56 BSC mainnet
BNB_RPC_URL=http://127.0.0.1:8546      # dedicated BNB Chain RPC in production
QUOTE_SIGNER_PRIVATE_KEY=              # signs EIP-712 checkout quotes; must equal CommerceEscrow.quoteSigner
QUOTE_TTL_SECONDS=900
OPENAI_API_KEY=                        # required for buyer agents; without it the UI shows a configuration error
OPENAI_MODEL=gpt-4.1-mini
AUTONOMOUS_PAYMENTS_ENABLED=false      # true only on networks where the agent contracts are deployed and reviewed
AGENT_EXECUTOR=                        # address of the agent key (public)

# --- api only ---
PORT=4100
APP_ORIGINS=http://localhost:3100      # comma-separated; used for SIWE domain + CSRF origin checks
ADMIN_ADDRESSES=                       # wallets granted ADMIN at sign-in
COOKIE_SECURE=true                     # always true behind HTTPS
UPLOAD_DIR=/var/lib/commerce-os/uploads # local media dir; mount a persistent volume or front with object storage

# --- worker only ---
REGISTRAR_PRIVATE_KEY=                 # holds MerchantRegistry.REGISTRAR_ROLE
AGENT_EXECUTOR_PRIVATE_KEY=            # agent key; can only call AgentAccount.agentCheckout
CONFIRMATIONS=3                        # blocks before an escrow event is treated as final
POLL_MS=2000

# --- web (Vercel) ---
API_URL=https://api.example.com        # server-side; the browser reaches it via the /api rewrite
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_BNB_CHAIN_ID=97            # omit to hide USDC/BNB
NEXT_PUBLIC_BNB_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_DEV_WALLET=false           # the Anvil test wallet is only ever offered on chain 31337
